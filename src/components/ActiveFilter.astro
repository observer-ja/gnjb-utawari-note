---
import ActiveFilterChip from "./ActiveFilterChip.astro";
import UnderlineText from "./UnderlineText.astro";
---

<section class="active-filters">
    <div class="active-filters__header">
        <UnderlineText>選択中の条件</UnderlineText>
    </div>
    <div class="active-chips-list" id="js-active-chips"></div>
    <a href="/gnjb-utawari-note/search/" class="reset-button text-body" id="js-reset-btn">条件をリセット</a>
</section>

<!-- style定義のためのダミー用のdiv -->
<div id="js-template-chip" style="display: none;">
    <ActiveFilterChip label="" name="" value="" />
</div>

<style>
    .active-filters {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .active-chips-list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        padding: 0 5px;
    }

    .reset-button {
        background: none;
        border: none;
        width: fit-content;
        padding: 0 5px;
        color: var(--color-primary);
        font-family: inherit;
        text-decoration: underline;
        transition: opacity 0.2s ease;
        cursor: pointer;
        margin-left: auto;
    }

    @media (hover:hover) {
        .reset-button:hover {
            opacity: 0.6;
        }
    }
</style>

<script>
    const form = document.querySelector<HTMLFormElement>('.search-form');
    const activeChipsContainer = document.getElementById('js-active-chips');

    const GROUP_NAME_MAP: Record<string, string> = {
        tieup: 'タイアップ：',
        call: 'コール：',
        mv: 'MV：',
        joysound: 'JOYSOUND：',
        dam: 'DAM：',
        live: 'ライブ：',
        cd: 'CD：',
        creator: 'クリエイター：'
    };

    const formatDate = (val: string) => val.replace(/-/g, '/');
    
    function renderActiveChips() {
        if (!form || !activeChipsContainer) return;
        activeChipsContainer.innerHTML = '';

        const inputs = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select');
        const processedLives = new Set<string>();

        let startDate = '';
        let endDate = '';
        
        inputs.forEach((input) => {
            if (input.closest('#js-template-chip')) return;
            if (input.name === 'sort') return;

            /* 日付 */
            if (input instanceof HTMLInputElement && (input.name === 'startDate' || input.name === 'endDate')) {
                const val = input.value.trim();
                if (val) {
                    if (input.name === 'startDate') startDate = val;
                    if (input.name === 'endDate') endDate = val;
                }
                return;
            }

            /* 曲名 */
            if (input instanceof HTMLInputElement && input.type === 'text') {
                const val = input.value.trim();
                if (val) addChipHTML(`「${val}」を含む`, input.name, val);
                return;
            }

            /* プルダウン（CD・クリエイター） */
            if (input instanceof HTMLSelectElement) {
                if (input.value) {
                    let text = input.options[input.selectedIndex].text;
                    if (GROUP_NAME_MAP[input.name]) {
                        text = `${GROUP_NAME_MAP[input.name]}${text}`;
                    }
                    addChipHTML(text, input.name, input.value);
                }
                return;
            }

            /* チップ（ライブ・タイアップ・MV・コール） */
            if (input instanceof HTMLInputElement && input.checked) {
                if (input.name === 'live') {
                    if (processedLives.has(input.value)) return;
                    processedLives.add(input.value);
                }

                let labelText = input.closest('label')?.textContent?.trim() || input.value;
                if (GROUP_NAME_MAP[input.name]) {
                    labelText = `${GROUP_NAME_MAP[input.name]}${labelText}`;
                }

                addChipHTML(labelText, input.name, input.value, input.type);
            }
        });

        if (startDate && endDate) {
            addChipHTML(`リリース日：${formatDate(startDate)} 〜 ${formatDate(endDate)}`, 'startDate,endDate', `${startDate}_${endDate}`);
        } else if (startDate) {
            addChipHTML(`リリース日：${formatDate(startDate)} 〜`, 'startDate', startDate);
        } else if (endDate) {
            addChipHTML(`リリース日：〜 ${formatDate(endDate)}`, 'endDate', endDate);
        }
    }

    function addChipHTML(label: string, name: string, value: string, type: string = 'checkbox') {
        if (!activeChipsContainer) return;

        const chipWrapper = document.createElement('div');
        chipWrapper.innerHTML = `
            <label class="active-filter-chip">
                <input type="${type}" data-name="${name}" value="${value}" data-value="${value}" class="active-chip-input" />
                <span class="active-chip-label text-sm">${label}</span>
                <span class="active-chip-close text-sm">×</span>
            </label>
        `;

        const chipElement = chipWrapper.firstElementChild as HTMLLabelElement;
        const chipInput = chipElement.querySelector<HTMLInputElement>('.active-chip-input');
        
        if (chipInput) chipInput.checked = true;

        chipElement.addEventListener('click', (e) => {
            e.preventDefault();

            if (chipInput) {
                chipInput.checked = !chipInput.checked;

                if (form) {
                    const names = name.split(',');
                    const selector = names.map(n => `[name="${n}"]`).join(',');
                    const panelInputs = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(selector);
                    panelInputs.forEach((panelInput) => {

                        /* 日付 */
                        if (panelInput instanceof HTMLInputElement && (panelInput.name === 'startDate' || panelInput.name === 'endDate')) {
                            const [startDate, endDate] = value.split('_');

                            if (chipInput.checked) {
                                if (name === 'startDate,endDate') {
                                    const [startDate, endDate] = value.split('_');
                                    panelInput.value = panelInput.name === 'startDate' ? startDate : endDate;
                                } else {
                                    panelInput.value = value;
                                }
                            } else {
                                panelInput.value = '';
                            }
                        }

                        /* 曲名 */
                        if (panelInput instanceof HTMLInputElement && panelInput.type === 'text') {
                            panelInput.value = chipInput.checked ? value : '';
                        }

                        /* プルダウン */
                        if (panelInput instanceof HTMLSelectElement) {
                            panelInput.value = chipInput.checked ? value : '';
                        } 
                        
                        /* チップ */
                        if (panelInput instanceof HTMLInputElement && (panelInput.value === value || panelInput.type === 'radio')) {
                            panelInput.checked = chipInput.checked;
                            panelInput.dataset.wasChecked = chipInput.checked ? 'true' : 'false';
                        }
                    });
                }
            }
        });

        activeChipsContainer.appendChild(chipElement);
    }

    form?.addEventListener('submit', () => {
        renderActiveChips();
    });

    form?.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement | HTMLSelectElement;
        if (!target || !activeChipsContainer) return;

        if (target instanceof HTMLInputElement) {
            const activeInput = activeChipsContainer.querySelector<HTMLInputElement>(
                `.active-chip-input[data-name="${target.name}"][value="${target.value}"]`
            );
            if (activeInput) {
                activeInput.checked = target.checked;
            }
        }

        if (target instanceof HTMLSelectElement) {
            const activeInput = activeChipsContainer.querySelector<HTMLInputElement>(
                `.active-chip-input[data-name="${target.name}"]`
            );
            if (activeInput) {
                activeInput.checked = target.value !== '';
            }
        }
    });

    renderActiveChips();

    (window as any).renderActiveChips = renderActiveChips;
</script>