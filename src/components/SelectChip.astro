---
interface Option {
    label: string;
    value: string;
}

interface OptionGroup {
    label: string;
    options: Option[];
}

type SelectOption = Option | OptionGroup;

interface Props {
    name: string;
    placeholder?: string;
    options: SelectOption[];
    defaultValue?: string;
    submitOnChange?: boolean;
}

const {
    name,
    placeholder,
    options,
    defaultValue = '',
    submitOnChange = false
} = Astro.props
---

<label class="select-chip">
    <select name={name} class="select-input text-body" onchange={submitOnChange ? "this.closest('form')?.submit()" : undefined}>
        {placeholder && (
            <option value="" selected={!defaultValue}>{placeholder}</option>
        )}
        {options.map((opt) => (
            'options' in opt ? (
                <optgroup label={opt.label}>
                    {opt.options.map((child) => (
                        <option value={child.value} selected={child.value === defaultValue}>
                            {child.label}
                        </option>
                    ))}
                </optgroup>
            ) : (
            <option value={opt.value} selected={opt.value === defaultValue}>
                {opt.label}
            </option>
            )
        ))}
    </select>
    <img src="/gnjb-utawari-note/icon-select.svg" alt="" class="select-icon">
</label>

<style>
    .select-chip {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 32px;
        width: fit-content;
        border-radius: 5px;
        border: 1px solid var(--color-text);
        box-sizing: border-box;
        background-color: var(--color-bg);
        white-space: nowrap;
    }

    @media (hover: hover) {
        .select-chip:hover {
            background-color: var(--color-bg-dark);
        }
    }

    .select-input {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        border: none;
        outline: none;
        background: transparent;
        font-family: inherit;
        color: var(--color-text);
        padding: 0px 32px 0px 12px;
        margin: 0;
        width: 100%;
        height: 100%;
        position: relative;
        z-index: 2;
        line-height: 30px;
    }

    .select-icon {
        position: absolute;
        right: 8px;
        top: 6px;
        transform: scaleY(-1);
        width: 20px;
        height: 20px;
        pointer-events: none;
        z-index: 0;
    }
</style>