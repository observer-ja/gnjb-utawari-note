---
import type { NewsItemType } from '../data/news';

interface Props {
    item: NewsItemType;
}

const { item } = Astro.props
---

<li class="news-item">
    <span class="news-date text-body">{item.date}</span>
    <a class="news-text text-body" href={`/gnjb-utawari-note/news/detail/${item.slug}/`}>{item.text}</a>
</li>

<style>
    .news-item {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 2px;
        padding: 5px 0 2px 5px;
        border-bottom: 1px solid var(--color-primary);
    }

    .news-date {
        width: 85px;
        flex-shrink: 0;
    }

    .news-text {
        flex: 1;
        text-decoration: none;
        color: inherit;
        word-break: break-all;
    }

    @media (hover:hover) {
        .news-text:hover {
            opacity: 0.6;
        }
    }

    @media (min-width: 1024px) {
        .news-item {
            gap: 5px;
        }
    }
</style>