---
import MemberChip from "./MemberChip.astro";
import type { SongLyrics } from "../data/songs/_template";

interface Props {
    lyricsData: SongLyrics | null;
}

const { lyricsData } = Astro.props

const MEMBERS = ['Y', 'W', 'S', 'B', 'R', 'G', 'P'] as const;
const hasAll = lyricsData?.lyrics_blocks.some((block) =>
    block.members?.includes('all') ||
    block.rows.some((row) =>
        row.members?.includes('all') ||
        row.chunks.some((chunk) =>
            chunk.members?.includes('all')
        )
    )
);
const hasCall = lyricsData?.lyrics_blocks.some((block) =>
    block.rows.some((row) =>
        row.chunks.some((chunk) =>
            chunk.text.some((t) => t.call === true)
        )
    )
);

const MEMBER_KEY_MAP: Record<string, string> = {
    Y: 'y',
    W: 'w',
    S: 's',
    B: 'b',
    R: 'r',
    G: 'g',
    P: 'p',
};

function getChunkStyle(members?: string[]) {
    if (!members || members.length === 0) {
        return '';
    }

    if (members.includes('all')) {
        return `background-color: var(--color-primary-light);`;
    }

    if (members.length === 1) {
        const key = MEMBER_KEY_MAP[members[0]];
        if (!key) return '';
        return `background-color: var(--color-${key}-bg);`;
    }

    const n = members.length;
    const stops = members
        .map((m) => MEMBER_KEY_MAP[m])
        .filter(Boolean)
        .map((key, index) => {
            const start = (index / n) * 100;
            const end = ((index + 1) / n) * 100;
            return `var(--color-${key}-bg) ${start}% ${end}%`;
        });

    return `background: linear-gradient(180deg, ${stops.join(', ')});`;
}
---

<div class="song-lyrics-section">
    <div class="song-lyrics__filter">
        {MEMBERS.map(m =>
            <MemberChip member={m}/>
        )}
        {hasAll &&
            <MemberChip member="all"/>
        }
        {hasCall && 
            <MemberChip member="call"/>
        }
    </div>
    <div class="song-lyrics__container text-body">
        {lyricsData ? (
            lyricsData.lyrics_blocks.map((block) => (
                <div class="song-lyrics__block">
                    {block.rows.map((row) => (
                        <div class="song-lyrics__row">
                            {row.chunks.map((chunk) => {
                                const activeMembers = chunk.members || row.members || block.members;
                                const hasCallInChunk = chunk.text.some((t) => t.call === true);
                                return (
                                    <div 
                                        class="song-lyrics__chunk" 
                                        style={getChunkStyle(activeMembers)}
                                        data-members={activeMembers?.join(',')}
                                        data-has-call={hasCallInChunk ? "true" : "false"}
                                    >
                                        {chunk.text.map((t) => (
                                            <span class={t.call ? "is_call" : ""}>{t.lyrics}</span>
                                        ))}
                                    </div>
                                );
                            })}
                        </div>
                    ))}
                </div>
            ))
        ) : (
                <p class="song-lyrics__empty">歌詞データは準備中です。</p>
        )}
    </div>
</div>

<style>
    .song-lyrics-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .song-lyrics__filter {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 8px;
    }

    .song-lyrics__container {
        display: flex;
        flex-direction: column;
        padding: 5px;
        gap: 16px;

        user-select: none;
        -webkit-user-select: none;
        -moz-user-select: none;
    }

    .song-lyrics__block {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .song-lyrics__row {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 4px;
    }

    .song-lyrics__chunk {
        height: fit-content;
        width: fit-content;
        padding: 5px 10px;
        border-radius: 5px;
    }

    .is_call {
        color: var(--color-text-colored);
    }

    @media (min-width: 1024px) {
        .song-lyrics__filter {
            gap: 16px;
        }

        .song-lyrics__container {
            gap: 24px;
        }

        .song-lyrics__block,
        .song-lyrics__row {
            gap: 8px;
        }
    }

    /* コール選択時：コールを含まないchunk全体（背景＋文字）を 0.25 に */
    .song-lyrics__chunk.is-call-dimmed {
        opacity: 0.25 !important;
    }

    /* コールを含むchunk：背景と通常文字を薄く見せるための処理 */
    .song-lyrics__chunk.has-call-span span:not(.is_call) {
        opacity: 0.25 !important;
    }

    /* コール選択時に、コールを含むchunkの背景も薄く見せるための重ね合わせ */
    .song-lyrics__chunk.has-call-span {
        box-shadow: inset 0 0 0 100px rgba(255, 255, 255, 0.75);
    }
</style>

<script>
    function setupMemberFilter() {
        const radios = document.querySelectorAll<HTMLInputElement>('.song-lyrics__filter .chip-input');
        const chunks = document.querySelectorAll<HTMLElement>('.song-lyrics__chunk');

        function filterChunks(selectedMember: string | null) {
            chunks.forEach((chunk) => {
                const spans = chunk.querySelectorAll<HTMLElement>('span');

                // 1. すべてのクラスとスタイルを初期状態にリセット
                chunk.style.opacity = '1';
                chunk.classList.remove('is-call-dimmed', 'has-call-span');
                spans.forEach((span) => (span.style.opacity = '1'));

                // 未選択（トグル解除）時はここで処理終了
                if (!selectedMember) return;

                if (selectedMember === 'call') {
                    const hasCall = chunk.dataset.hasCall === 'true';

                    if (hasCall) {
                        // コールを含むchunk: 
                        // JSはクラス付与のみ行い、CSS側で通常文字と背景の白重ね（0.25相当）を行う
                        chunk.classList.add('has-call-span');
                        spans.forEach((span) => {
                            const isCall = span.classList.contains('is_call');
                            span.style.opacity = isCall ? '1' : '0.25';
                        });
                    } else {
                        // コールを含まないchunk: 全体を 0.25 に
                        chunk.classList.add('is-call-dimmed');
                    }
                } else {
                    // メンバー/all 選択時: 該当しない chunk 全体を 0.25 に
                    const members = chunk.dataset.members ? chunk.dataset.members.split(',') : [];
                    const isMatched = members.includes(selectedMember) || members.includes('all');
                    
                    if (!isMatched) {
                        chunk.style.opacity = '0.25';
                    }
                }
            });
        }

        radios.forEach((radio) => {
            radio.addEventListener('click', (e) => {
                const target = e.currentTarget as HTMLInputElement;
                const wasChecked = target.dataset.wasChecked === 'true';

                if (wasChecked) {
                    target.checked = false;
                    target.dataset.wasChecked = 'false';
                    filterChunks(null);
                } else {
                    radios.forEach((r) => (r.dataset.wasChecked = 'false'));
                    target.dataset.wasChecked = 'true';
                    filterChunks(target.value);
                }
            });
        });
    }

    setupMemberFilter();
</script>