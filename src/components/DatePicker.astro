---
interface Props {
    text: string;
    name: 'startDate' | 'endDate';
    value?: string;
}

const { text, name, value } = Astro.props;
---

<label class="date-picker">
    <input 
        type={value ? "date" : "text"} 
        name={name} 
        value={value} 
        placeholder={text} 
        class="date-input text-body"
        onfocus="this.type='date'; this.showPicker?.();"
        onblur="if(!this.value) this.type='text';"
    />
</label>

<style>
    .date-picker {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        width: 130px;
        max-width: 100%;
        padding: 2px 12px;
        border-radius: 20px;
        border: 1px solid color-mix(in srgb, var(--color-text) 25%, transparent);
        box-sizing: border-box;
        background-color: var(--color-bg);
        cursor: pointer;
        overflow: hidden;
    }

    @media (hover: hover) {
        .date-picker:hover {
            background-color: var(--color-bg-dark);
        }
    }

    .date-input {
        border: none;
        outline: none;
        background: transparent;
        font-family: inherit;
        text-align: center;
        cursor: pointer;
        padding: 0;
        margin: 0;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .date-input::placeholder {
        color: var(--color-text);
        opacity: 0.25;
    }

    .date-input::-webkit-calendar-picker-indicator {
        display: none;
    }

    .date-picker:has(.date-input[type="date"]) {
        border-color: var(--color-text);
    }
</style>