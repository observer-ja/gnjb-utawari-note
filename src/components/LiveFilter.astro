---
import FilterChip from '../components/FilterChip.astro';
import { lives, type Live } from '../data/lives';

import OnemanIcon from '/icon-oneman.svg?raw';
import FesIcon from '/icon-fes.svg?raw';
import StreamIcon from '/icon-stream.svg?raw';

const livesByYear = lives.reduce<Record<string, Live[]>>((acc, live) => {
    const year = live.date.substring(0, 4);
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(live);
    return acc;
}, {});
const years = Object.keys(livesByYear).sort((a, b) => Number(b) - Number(a));
---

<div class="live-filter">
    <div class="live-filter__legend">
        <div class="live-filter__legend-item">
            <span class="live-filter__legend-icon">
                <Fragment set:html={OnemanIcon} />
            </span>
            <span class="text-caption"> ＝ ワンマンライブ</span>
        </div>
        <div class="live-filter__legend-item">
            <span class="live-filter__legend-icon">
                <Fragment set:html={FesIcon} />
            </span>
            <span class="text-caption"> ＝ フェス・合同ライブ</span>
        </div>
        <div class="live-filter__legend-item">
            <span class="live-filter__legend-icon">
                <Fragment set:html={StreamIcon} />
            </span>
            <span class="text-caption"> ＝ 配信ライブ</span>
        </div>
    </div>
    <div class="live-filter__yearly">
        {years.map((year) => (
            <div class="live-filter__year-group">
                <p class="live-filter__year-title text-body">{year}年</p>
                <div class="live-filter__year-content">
                    {livesByYear[year].toReversed().map((live) => (
                        <FilterChip 
                            label={live.name} 
                            name="live" 
                            value={live.id} 
                            icon={live.type} 
                        />
                    ))}
                </div>
            </div>
        ))}
    </div>
</div>

<style>
    .live-filter {
        width: auto;
        height: auto;
        max-height: 320px;
        overflow-y: auto;
        background-color: var(--color-bg);
        padding: 12px;
        border: 1px dashed var(--color-primary);
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        
    }

    .live-filter__yearly {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .live-filter__year-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .live-filter__year-title {
        position: sticky;
        top: 0;
        background-color: var(--color-bg);
        z-index: 1;
        padding: 0;
        margin: 0;
        color: var(--color-primary);
        border-bottom: 1px solid var(--color-primary);
    }

    .live-filter__year-content {
        display: flex;
        flex-wrap: wrap;
        padding: 0 5px;
        gap: 8px 12px;
    }

    .live-filter__legend {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 4px 12px;
        align-items: center;
    }

    .live-filter__legend-item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--color-primary);
    }

    .live-filter__legend-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
    }

    .live-filter__legend-icon :global(svg) {
        width: 100%;
        height: 100%;
        fill: currentColor;
    }

    @media (min-width: 1024px) {
        .live-filter {
            padding: 24px;
        }

        .live-filter__yearly {
            gap: 12px;
        }

        .live-filter__year-content {
            gap: 12px 16px;
        }
    }
</style>