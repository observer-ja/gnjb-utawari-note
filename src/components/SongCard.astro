---
import SongCardBody from "./SongCardBody.astro";
import FeatureBadge from "./FeatureBadge.astro";
import type { Song } from '../data/index'

interface Props {
    song: Song;
    displayMode?: 'default' | 'setlist';
    liveId?: string;
}

const { song, displayMode = 'default', liveId } = Astro.props
---
<a class="song-card" href={`/gnjb-utawari-note/songs/${song.id}`}>
    <div class="song-card__header text-body">{song.title}</div>
    <SongCardBody song={song} displayMode={displayMode} liveId={liveId} />
    <div class="song-card__footer">
        {song.tieup.length > 0 && <FeatureBadge type="tieup" />}
        {song.call && <FeatureBadge type="call" />}
        {song.links.mv && <FeatureBadge type="mv" />}
    </div>
</a>

<style>
    .song-card {
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        height: fit-content;
        width: 100%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        padding: 0;
        gap: 0;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--color-primary);
        box-sizing: border-box;
        background-color: var(--color-primary);
    }

    .song-card__header {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 60px;
        padding: 3px 6px;
        background-color: var(--color-primary);
        text-align: center;
        word-break: break-word;
        box-sizing: border-box;
    }

    .song-card__footer {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        align-content: center;
        height: 56px;
        padding: 2px;
        gap: 2px;
        background-color: var(--color-bg-dark);
    }

    @media (hover:hover) {
        .song-card:hover {
            border: 1px solid var(--color-text);
            --card-body-bg: var(--color-bg-dark);
        }
    }

    .song-card:active {
        --card-body-bg: var(--color-primary);
        --card-body: var(--color-bg);
    }

    .song-card:active .song-card__header {
        color: var(--color-bg);
    }

    .song-card:active .song-card__footer {
        background-color:  var(--color-primary);
    }
</style>