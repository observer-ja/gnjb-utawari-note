---
import type { LiveType } from '../data/lives'

import OnemanIcon from '/icon-oneman.svg?raw';
import FesIcon from '/icon-fes.svg?raw';
import StreamIcon from '/icon-stream.svg?raw';

interface Props {
    label: string; /* チップの文字 */
    name: 'live' | 'mv' | 'call' | 'tieup' | 'other'; /* チップの種類 */
    value: string; /*　チップによる情報　*/
    type?: 'checkbox' | 'radio';
    icon?: LiveType;
    checked?: boolean;
}

const {
    label,
    name,
    value,
    type = 'checkbox',
    icon,
    checked = false,
} = Astro.props;

const ICON_MAP = {
    oneman: OnemanIcon,
    fes: FesIcon,
    stream: StreamIcon,
};

const IconObj = icon ? ICON_MAP[icon] : null;
---

<label class="filter-chip">
    <input type={type} name={name} value={value} class="chip-input" checked={checked} data-was-checked={checked ? "true" : "false"}/>
    {IconObj && (
        <span class="chip-icon">
            <Fragment set:html={IconObj} />
        </span>
    )}
    <span class="chip-label text-body">{label}</span>
</label>

<style>
    .filter-chip {
        display: inline-flex;
        align-items: center;
        height: 32px;
        width: fit-content;
        padding: 2px 12px;
        gap: 2px;
        border-radius: 20px;
        border: 1px solid var(--color-primary);
        box-sizing: border-box;
        background-color: var(--color-bg);
        color: var(--color-primary);
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    @media (hover:hover) {
        .filter-chip:hover {
            background-color: var(--color-bg-dark);
        }
    }

    .filter-chip:has(.chip-input:checked) {
        background-color: var(--color-primary);
        color: var(--color-bg);
    }

    @media (hover:hover) {
        .filter-chip:has(.chip-input:checked):hover {
            border: 1px solid var(--color-text);
        }
    }

    .chip-input {
        display: none;
    }

    .chip-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
    }

    .chip-icon :global(svg) {
        width:  100%;
        height: 100%;
        fill: currentColor;
        stroke: currentColor;
    }

    
</style>