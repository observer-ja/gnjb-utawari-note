---
interface Props {
    note: '初披露' | 'シャッフル曲' | '日替わり曲' | 'メドレー';
}

const { note } = Astro.props
---

<span class="note-badge">
    <span class="text-sm">{note}</span>
</span>

<style>
    .note-badge {
        height: 20px;
        width: fit-content;
        display: inline-flex;
        flex-direction: row;
        align-items: center;
        background-color: var(--color-bg-dark);
        border: 1px solid var(--color-text);
        box-sizing: border-box;
        border-radius: 5px;
        padding: 0 4px;
    }
</style>