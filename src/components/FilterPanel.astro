---
import ExpandToggleChip from './ExpandToggleChip.astro';
import FilterChip from '../components/FilterChip.astro';
import LiveFilter from '../components/LiveFilter.astro';
import DatePicker from '../components/DatePicker.astro';
import SelectChip from '../components/SelectChip.astro';
import SearchInput from '../components/SearchInput.astro';
import Button from './Button.astro';

interface FilterState {
    selectedLives: string[];
    startDate: string;
    endDate: string;
    cd: string;
    creator: string;
    tieup: string;
    call: string;
    mv: string;
    query: string;
    sortOrder: string;
    expanded?: boolean;
}

interface Props {
    filters?: FilterState;
}

const { filters = {
    selectedLives: [],
    startDate: '',
    endDate: '',
    cd: '',
    creator: '',
    tieup: '',
    call: '',
    mv: '',
    query: '',
    sortOrder: ' ',
    expanded: false,
} } = Astro.props;

import { lives } from '../data/lives';
const recentLives = lives.slice(-3).reverse().map((live) => ({
    label: live.name,
    value: live.id,
}));

import { cds } from '../data/cds';
const cdOptions = cds.map((cd) => ({
    label: cd.title,
    value: cd.id,
}));

import { songsIndex } from '../data/index'
import type { Song } from '../data/index';
const allCreators: string[] = (songsIndex || []).flatMap((song: Song) => [
    ...(song.lyricist || []),
    ...(song.composer || []),
    ...(song.arranger || [])
]);
const uniqueCreators = [...new Set(allCreators)]
    .sort((a, b) => a.localeCompare(b, 'ja'));
const creatorOptions = uniqueCreators.map(creator => ({
    label: creator,
    value: creator,
}));
---

<div class="filter-panel">
    <input type="hidden" name="sort" value={filters.sortOrder} />
    <div class="filter-panel__header">
        <h2 class="filter-panel__title text-md">絞り込み条件</h2>
        <div class="filter-panel__toggle">
            <ExpandToggleChip expandText='開く' isExpanded={filters.expanded}/>
        </div>
    </div>
    <div class="filter-panel__content">
        <div class="filter-panel__body">
            <div class="filter-group">
                <p class="filter-group__label text-body">ライブ</p>
                <div class="filter-group__content">
                    <div class="default-live-chips">
                        {recentLives.map((live) => (
                            <FilterChip 
                                label={live.label} 
                                name="live" 
                                value={live.value}
                                checked={filters.selectedLives.includes(live.value)} 
                            />
                        ))}
                        <ExpandToggleChip expandText='すべてのライブを見る'/>
                    </div>
                    <div class="expandable-live-filter">
                        <LiveFilter selectedLives={filters.selectedLives}/>
                    </div>
                </div>
            </div>
            <div class="filter-group">
                <p class="filter-group__label text-body">リリース日</p>
                <div class="filter-group__content">
                    <DatePicker text='開始日' name='startDate' value={filters.startDate}></DatePicker>
                    <span>〜</span>
                    <DatePicker text='終了日' name='endDate' value={filters.endDate}></DatePicker>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-group">
                    <p class="filter-group__label text-body">収録CD</p>
                    <div class="filter-group__content">
                        <SelectChip 
                            name='cd'
                            placeholder='収録CDを選択'
                            options={cdOptions}
                            defaultValue={filters.cd}
                        />
                    </div>
                </div>
                <div class="filter-group">
                    <p class="filter-group__label text-body">クリエイター</p>
                    <div class="filter-group__content">
                        <SelectChip 
                            name='creator'
                            placeholder='クリエイターを選択'
                            options={creatorOptions}
                            defaultValue={filters.creator}
                        />
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-group">
                    <p class="filter-group__label text-body">タイアップ</p>
                    <div class="filter-group__content">
                        <FilterChip label="あり" name="tieup" value="true" type='radio' checked={filters.tieup === 'true'} />
                        <FilterChip label="なし" name="tieup" value="false" type='radio' checked={filters.tieup === 'false'}/>
                    </div>
                </div>
                <div class="filter-group">
                    <p class="filter-group__label text-body">コール</p>
                    <div class="filter-group__content">
                        <FilterChip label="あり" name="call" value="true" type='radio' checked={filters.call === 'true'}/>
                        <FilterChip label="なし" name="call" value="false" type='radio' checked={filters.call === 'false'}/>
                    </div>
                </div>
                <div class="filter-group">
                    <p class="filter-group__label text-body">MV</p>
                    <div class="filter-group__content">
                        <FilterChip label="あり" name="mv" value="true" type='radio' checked={filters.mv === 'true'}/>
                        <FilterChip label="なし" name="mv" value="false" type='radio' checked={filters.mv === 'false'}/>
                    </div>
                </div>
            </div>
            <div class="filter-group filter-group--search">
                <p class="filter-group__label text-body">曲名検索</p>
                <div class="filter-group__content">
                    <SearchInput defaultValue={filters.query}/>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .filter-panel__header {
        display: flex;
        flex: row;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .filter-panel {
        background-color: var(--color-bg-dark);
        border: 1px solid var(--color-primary);
        box-sizing: border-box;
        border-radius: 12px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-panel__title {
        margin: 0;
        padding: 0 5px 5px 5px;
    }

    .filter-panel__toggle {
        display: block;
    }

    .filter-panel__content {
        display: none;
    }

    .filter-panel:has(.expand-toggle-chip[data-expanded="true"]) .filter-panel__content {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-panel__body {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

    .filter-group__label {
        margin: 0;
        padding: 5px;
    }

    .filter-group__content {
        padding: 0 5px;
        gap: 8px 12px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    .default-live-chips {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
    }

    .expandable-live-filter {
        display: none;
        width: 100%;
    }

    .filter-group:has(.expand-toggle-chip[data-expanded="true"]) .expandable-live-filter {
        display: block;
        margin-top: 12px;
    }

    .filter-row {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-panel__action {
        display: flex;
        justify-content: center;
        padding: 12px 0;
    }

    @media (min-width: 1024px) {
        .filter-panel {
            border-radius: 20px;
            padding: 48px;
            gap: 12px;
        }

        .filter-panel__toggle {
            display: none;
        }

        .filter-panel__content {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .filter-panel__body {
            gap: 12px;
        }

        .filter-group {
            flex: 1;
            align-items: flex-start;
            flex-direction: row;
            gap: 6px;
        }

        .filter-group__label {
            width: 120px;
            flex-shrink: 0;
            padding-top: 10px;
        }

        .filter-group__content {
            flex: 1;
            display: flex;
            justify-content: flex-start;
            gap: 12px 16px;
            padding: 8px 5px;
        }

        .filter-row {
            flex-direction: row;
            align-items: center;
            gap: 48px;
        }
    }
</style>

<script>
    const toggleChip = document.querySelector('.filter-panel__toggle .expand-toggle-chip');
    const expandedInput = document.getElementById('expanded-input') as HTMLInputElement;

    if (toggleChip && expandedInput) {
        toggleChip.addEventListener('click', () => {
            // トグル後の状態（CSS側で data-expanded が切り替わるタイミング）を反転させてセット
            const isExpanded = toggleChip.getAttribute('data-expanded') === 'true';
            expandedInput.value = isExpanded ? 'true' : 'false';
        });
    }

    ['tieup', 'mv', 'call'].forEach((name) => {
        const chips = document.querySelectorAll(`input[name="${name}"]`);
        
        chips.forEach((chip) => {
            chip.addEventListener('click', (e) => {
                const target = e.target as HTMLInputElement;
                
                if (target.dataset.wasChecked === 'true') {
                    target.checked = false;
                    target.dataset.wasChecked = 'false';
                } else {
                    chips.forEach((c) => ((c as HTMLInputElement).dataset.wasChecked = 'false'));
                    target.dataset.wasChecked = 'true';
                }
            });
        });
    });

    const liveInputs = document.querySelectorAll<HTMLInputElement>('input[name="live"]');

    liveInputs.forEach((input) => {
        input.addEventListener('change', (e) => {
            const target = e.target as HTMLInputElement;
            const targetValue = target.value;
            const isChecked = target.checked;
            const matchingInputs = document.querySelectorAll<HTMLInputElement>(
                `input[name="live"][value="${targetValue}"]`
            );

            matchingInputs.forEach((matchingInput) => {
                matchingInput.checked = isChecked;
            });
        });
    });
</script>