---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import FilterPanel from '../components/FilterPanel.astro';
import ActiveFilter from '../components/ActiveFilter.astro';

import { songsIndex } from '../data/index';
import type { Song } from '../data/index';

const searchParams = Astro.url.searchParams;
const selectedLives = searchParams.getAll('live').filter(Boolean);
const startDate = searchParams.get('startDate');
const endDate = searchParams.get('endDate');
const cd = searchParams.get('cd');
const creator = searchParams.get('creator');
const tieup     = searchParams.get('tieup');
const call      = searchParams.get('call');
const mv        = searchParams.get('mv');
const query        = searchParams.get('keyword');

const sortOrder = searchParams.get('sort') || 'date-desc';

const isSetlistSortable =
    selectedLives.length === 1 && !startDate && !endDate && !cd && !creator && !tieup && !call && !mv && !query

const filteredSongs = (songsIndex || []).filter(song => {
    if (selectedLives.length > 0) {
        const hasLive = song.live_history?.some((live) => selectedLives.includes(live.live_id));
        if (!hasLive) return false;
    }

    if (startDate && song.date < startDate) return false;
    if (endDate && song.date > endDate) return false;

    if (cd && song.cds?.some((c) => c.id === cd)) return false;
    if (creator) {
        const hasCreator =
            song.lyricist?.includes(creator) ||
            song.composer?.includes(creator) ||
            song.arranger?.includes(creator);

        if(!hasCreator) return false;
    }

    if (tieup === 'true' && !song.tieup) return false;
    if (tieup === 'false' && song.tieup) return false;

    
})
---

<Layout title='楽曲を探す'>
    <PageHeader title="楽曲を探す" />
    <div class="container">
        <FilterPanel/>
        <ActiveFilter/>
    </div>
</Layout>

<!--
1. データのインポート
全楽曲データ（songsIndex）と、型定義（Song）を読み込みます。

2. URLパラメータ（クエリ）の取得
Astro.url.searchParams を使って、URLに付与されているパラメータをすべて変数に取得します。

絞り込み用: live, startDate, endDate, cd, creator, tieup, call, mv, q（曲名）など

並び替え用: sort（未指定の場合はデフォルト値、例: 'date-desc' を設定）

3. 「セトリ順ソート可否（isSetlistSortable）」の判定
プルダウンに「セトリ順」を出すかどうかを決める boolean フラグを作ります。

条件: live パラメータが「1つだけ指定されている」かつ「他の絞り込みパラメータが一切存在しない」こと。

4. 配列の絞り込み（filter）
全楽曲データに対して .filter() を実行します。

各パラメータが存在する場合のみ、条件に合致するかチェックして弾く（false を返す）処理を書きます。

例: tieup が 'true' なのに song.tieup が空なら除外

5. 配列の並び替え（sort）
絞り込んだ配列をコピー（[...filtered]）し、.sort() で並び替えます。

sort パラメータの値（date-desc, date-asc, title-asc, setlist）に応じて、比較関数（localeCompare や日付比較など）を分岐させます。
-->