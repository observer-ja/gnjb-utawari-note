---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import FilterPanel from '../components/FilterPanel.astro';
import ActiveFilter from '../components/ActiveFilter.astro';
import UnderlineText from '../components/UnderlineText.astro';

import SongCard from '../components/SongCard.astro';
import { songsIndex } from '../data/index'
const song = songsIndex;
---

<Layout title='楽曲を探す'>
    <PageHeader title="楽曲を探す" />
    <div class="container">
        <FilterPanel/>
        <ActiveFilter/>
        <div class="a">
            <SongCard song={song[32]} liveId='live2025_04'/>
        </div>
    </div>
</Layout>

<style>
    .a {
        display: flex;
    }
</style>