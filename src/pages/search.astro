---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import FilterChip from '../components/FilterChip.astro';

import iconOneman from '/public/icon-oneman.svg?raw';
import DatePicker from '../components/DatePicker.astro';
---

<Layout title='楽曲を探す'>
    <PageHeader title="楽曲を探す" />
    <div class="container">
        <div class="filter-group">
            <FilterChip label='原因は君にもある。' name='live' value='test' icon={iconOneman}/>
            <DatePicker text='開始日' name='startDate' />
        </div>
    </div>
</Layout>

<style>
    .filter-group {
        display: flex;
        align-items: center;
        gap: 8px; /* チップ同士の間隔（お好みで調整してください） */
    }
</style>