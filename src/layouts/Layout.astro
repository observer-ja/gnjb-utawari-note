---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const {
    title,
    description = "原因は自分にある。の楽曲パート分け・歌割りやライブ披露履歴をまとめた非公式ファンサイトです。",
    image = "/gnjb-utawari-note/ogp.png",
} = Astro.props;

const siteName = "原因は自分にある。歌割りノート";
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImageURL = new URL(image, Astro.site ?? Astro.url);
---

<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{pageTitle}</title>
        <meta name="description" content={description}>
        <meta name="google-site-verification" content="dIO3edabie5cx87OQ-bCVqpFNnRqMr5ZFO0Pxj0u3b0" />
        <link rel="canonical" href={canonicalURL}>
        <meta property="og:type" content="website">
        <meta property="og:url" content={canonicalURL}>
        <meta property="og:site_name" content={siteName}>
        <meta property="og:title" content={pageTitle}>
        <meta property="og:description" content={description}>
        <meta property="og:image" content={ogImageURL}>
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content={pageTitle}>
        <meta name="twitter:description" content={description}>
        <meta name="twitter:image" content={ogImageURL}>

        <link rel="icon" type="image/png" sizes="192x192" href="https://observer-ja.github.io/gnjb-utawari-note/favicon.png" />
        <link rel="icon" href="https://observer-ja.github.io/gnjb-utawari-note/logo.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="https://observer-ja.github.io/gnjb-utawari-note/favicon.png" />

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": siteName,
            "url": "https://observer-ja.github.io/gnjb-utawari-note/"
        })} />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet">
    </head>
    <body>
        <Header />
        <main class="main-content">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    body {
        margin: 0;
        padding: 0;
    }

    :global(.container) {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    :global(.color-text) {
        color: var(--color-text-colored);
    }

    @media (min-width: 1024px) {
        :global(.container) {
            padding: 60px 120px;
            gap: 32px;
        }
    }
</style>