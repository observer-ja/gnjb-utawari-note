---
import Layout from "./Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import UnderlineText from "../components/UnderlineText.astro";

interface Props {
    title: string;
    date: string;
}

const { title, date } = Astro.props
---

<Layout title = {title}>
    <div class="container">
        <div class="news-header">
            <p class="news-date text-body">{date}</p>
            <SectionTitle>{title}</SectionTitle>
        </div>
        <slot/>
    </div>
</Layout>

<style>
    .news-header {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .news-date {
        margin: 0;
        padding: 0;
    }

    :global(.article-container) {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    :global(.article-lead) {
        margin: 0;
        padding: 0;
    }

    :global(.article-section) {
        display: flex;
        flex-direction: column;
    }

    :global(.article-heading) {
        font-weight: bold;
        margin: 0;
        padding: 0;
    }

    :global(.article-text) {
        margin: 0;
        padding: 0;
    }

    :global(.article-list) {
        margin: 0;
        padding: 0 0 0 40px;
    }

    :global(.article-note) {
        margin: 0;
        padding: 0;
    }

    @media (min-width: 1024px) {
        .news-header {
            gap: 12px
        }

        :global(.article-container) {
            gap: 24px;
        }
    }
</style>